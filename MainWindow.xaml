<Window x:Class="ToolBoxPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0"
                Background="#2B2B2B"
                Width="{Binding IsPaneOpen, Converter={StaticResource PaneWidthConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 汉堡菜单按钮 -->
                <Button Grid.Row="0"
                       Command="{Binding TogglePaneCommand}"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="White"
                       Padding="15"
                       HorizontalAlignment="Left">
                    <TextBlock Text="☰" FontSize="20"/>
                </Button>

                <!-- 导航菜单 -->
                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <Button Command="{Binding NavigateToCommand}"
                           CommandParameter="Home"
                           Background="Transparent"
                           BorderThickness="0"
                           Foreground="White"
                           Padding="15,10"
                           HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="首页" FontSize="14"
                                     Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCommand}"
                           CommandParameter="PdfSplit"
                           Background="Transparent"
                           BorderThickness="0"
                           Foreground="White"
                           Padding="15,10"
                           HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="PDF工具" FontSize="14"
                                     Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCommand}"
                           CommandParameter="ImageConverter"
                           Background="Transparent"
                           BorderThickness="0"
                           Foreground="White"
                           Padding="15,10"
                           HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🖼️" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="图片转换" FontSize="14"
                                     Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCommand}"
                           CommandParameter="FileRename"
                           Background="Transparent"
                           BorderThickness="0"
                           Foreground="White"
                           Padding="15,10"
                           HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="批量重命名" FontSize="14"
                                     Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCommand}"
                           CommandParameter="ScrollCapture"
                           Background="Transparent"
                           BorderThickness="0"
                           Foreground="White"
                           Padding="15,10"
                           HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📷" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="滚动截屏" FontSize="14"
                                     Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCommand}"
                           CommandParameter="ThreeDMap"
                           Background="Transparent"
                           BorderThickness="0"
                           Foreground="White"
                           Padding="15,10"
                           HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌍" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="3D地图" FontSize="14"
                                     Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToCommand}"
                           CommandParameter="ProteinViewer"
                           Background="Transparent"
                           BorderThickness="0"
                           Foreground="White"
                           Padding="15,10"
                           HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧬" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="蛋白质3D" FontSize="14"
                                     Visibility="{Binding IsPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Frame x:Name="MainFrame"
               Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="#F5F5F5"/>
    </Grid>
</Window>
