<UserControl x:Class="ToolBoxPro.Views.PdfSplitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="PDF拆分工具"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- 源文件选择 -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                     Text="源文件:"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"/>

            <TextBox Grid.Column="1"
                    Text="{Binding SourceFilePath}"
                    IsReadOnly="True"
                    VerticalAlignment="Center"
                    Padding="5"/>

            <Button Grid.Column="2"
                   Content="浏览..."
                   Command="{Binding SelectSourceFileCommand}"
                   Margin="10,0,0,0"
                   Padding="15,5"/>
        </Grid>

        <!-- 页数信息 -->
        <TextBlock Grid.Row="2"
                  Text="{Binding TotalPages, StringFormat='总页数: {0} 页'}"
                  Margin="0,0,0,15"
                  Visibility="{Binding TotalPages, Converter={StaticResource IntToVisibilityConverter}}"/>

        <!-- 输出目录选择 -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                     Text="输出目录:"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0"/>

            <TextBox Grid.Column="1"
                    Text="{Binding OutputDirectory}"
                    IsReadOnly="True"
                    VerticalAlignment="Center"
                    Padding="5"/>

            <Button Grid.Column="2"
                   Content="浏览..."
                   Command="{Binding SelectOutputDirectoryCommand}"
                   Margin="10,0,0,0"
                   Padding="15,5"/>
        </Grid>

        <!-- 拆分模式 -->
        <GroupBox Grid.Row="4" Header="拆分模式" Margin="0,0,0,15">
            <StackPanel Margin="10">
                <ComboBox ItemsSource="{Binding SplitModes}"
                         SelectedItem="{Binding SelectedMode}"
                         Margin="0,0,0,10"/>

                <!-- 按范围拆分选项 -->
                <StackPanel Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ByRange}">
                    <TextBlock Text="页码范围 (例如: 1-5, 8-10):"
                             Margin="0,0,0,5"/>
                    <TextBox Text="{Binding PageRangesText}"
                            Padding="5"/>
                </StackPanel>

                <!-- 按间隔拆分选项 -->
                <StackPanel Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ByInterval}">
                    <TextBlock Text="每份页数:"
                             Margin="0,0,0,5"/>
                    <TextBox Text="{Binding PageInterval}"
                            Padding="5"/>
                </StackPanel>

                <!-- 提取页面选项 -->
                <StackPanel Visibility="{Binding SelectedMode, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ExtractPages}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="起始页:"
                                     Margin="0,0,0,5"/>
                            <TextBox Text="{Binding StartPage}"
                                    Padding="5"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                 Text=" - "
                                 VerticalAlignment="Bottom"
                                 Margin="10,0"
                                 Padding="0,5"/>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="结束页:"
                                     Margin="0,0,0,5"/>
                            <TextBox Text="{Binding EndPage}"
                                    Padding="5"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- 输出文件列表 -->
        <GroupBox Grid.Row="5" Header="输出文件" Margin="0,0,0,15">
            <ListBox ItemsSource="{Binding OutputFiles}"
                    Margin="5"/>
        </GroupBox>

        <!-- 按钮和状态 -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                     Text="{Binding StatusMessage}"
                     VerticalAlignment="Center"
                     Foreground="Gray"/>

            <ProgressBar Grid.Column="1"
                        IsIndeterminate="{Binding IsBusy}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Height="20"
                        Margin="10,0"/>

            <Button Grid.Column="2"
                   Content="打开输出文件夹"
                   Command="{Binding OpenOutputFolderCommand}"
                   Margin="5,0"
                   Padding="15,5"/>

            <Button Grid.Column="3"
                   Content="清空"
                   Command="{Binding ClearCommand}"
                   Margin="5,0"
                   Padding="15,5"/>

            <Button Grid.Column="4"
                   Content="开始拆分"
                   Command="{Binding SplitPdfCommand}"
                   IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                   Background="#0078D4"
                   Foreground="White"
                   Padding="20,8"
                   FontWeight="Bold"/>
        </Grid>
    </Grid>
</UserControl>
