<UserControl x:Class="ToolBoxPro.Views.ThreeDMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="3D 区划地图生成器"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Border Grid.Row="1"
                    Background="#E8F4FF"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,18">
                <TextBlock TextWrapping="Wrap"
                           LineHeight="22"
                           Text="根据 GeoJSON 数据生成单文件 Three.js 3D 地图页面。支持省份立体挤出、边界线、鼠标旋转缩放、悬停高亮与 tooltip。生成的 HTML 可直接用浏览器打开。"/>
            </Border>

            <GroupBox Grid.Row="2" Header="地图数据" Margin="0,0,0,15">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="页面标题:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Title}" Padding="6" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="GeoJSON:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding GeoJsonUrl}" Padding="6" Margin="0,0,10,8"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="全国预设" Command="{Binding UseChinaPresetCommand}" Padding="12,5" Margin="0,0,8,8"/>
                    <Button Grid.Row="1" Grid.Column="3" Content="浙江预设" Command="{Binding UseZhejiangPresetCommand}" Padding="12,5" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="投影中心:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="经度" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ProjectionCenterLongitude}" Width="90" Padding="6" Margin="0,0,15,0"/>
                        <TextBlock Text="纬度" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding ProjectionCenterLatitude}" Width="90" Padding="6"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="显示样式" Margin="0,0,0,15">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                        <TextBlock Text="顶面颜色" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding TopColor}" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,12">
                        <TextBlock Text="侧面颜色" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding SideColor}" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,10,12">
                        <TextBlock Text="边界颜色" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding BorderColor}" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,0,12">
                        <TextBlock Text="高亮颜色" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding HighlightColor}" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,10,12">
                        <TextBlock Text="立体厚度" Margin="0,0,0,5"/>
                        <Slider Value="{Binding ExtrudeDepth}" Minimum="1" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="{Binding ExtrudeDepth, StringFormat='当前厚度：{0}'}" Foreground="Gray"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="星空背景" IsChecked="{Binding ShowStars}" Margin="0,0,20,0"/>
                        <CheckBox Content="显示区划文字标签" IsChecked="{Binding ShowLabels}"/>
                    </StackPanel>

                    <Button Grid.Row="2" Grid.Column="0" Content="恢复默认样式" Command="{Binding ResetStyleCommand}" Padding="12,6" HorizontalAlignment="Left"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="4" Header="输出设置" Margin="0,0,0,15">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="输出文件:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding OutputPath}" IsReadOnly="True" Padding="6" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="浏览..." Command="{Binding SelectOutputPathCommand}" Padding="15,6"/>
                </Grid>
            </GroupBox>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="160" Height="18" Margin="0,0,12,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <Button Grid.Column="1" Content="打开输出位置" Command="{Binding OpenOutputFolderCommand}" Padding="15,8" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="生成 HTML" Command="{Binding GenerateMapCommand}" Padding="18,8" Margin="0,0,8,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                <Button Grid.Column="3" Content="生成并打开" Command="{Binding GenerateAndOpenCommand}" Padding="20,8"
                        Background="#0078D4" Foreground="White" FontWeight="Bold"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
