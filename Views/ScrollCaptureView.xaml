<UserControl x:Class="ToolBoxPro.Views.ScrollCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="滚动截屏工具"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- 说明 -->
        <Border Grid.Row="1" 
                Background="#E3F2FD" 
                CornerRadius="5" 
                Padding="15"
                Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="使用说明" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock TextWrapping="Wrap" Text="1. 点击「选择区域」用鼠标拖拽选择要截取的区域" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Text="2. 选择模式：自动滚动或手动滚动" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Text="3. 点击「开始截屏」开始捕获" Margin="0,0,0,5"/>
                <TextBlock TextWrapping="Wrap" Foreground="#FF5722" FontWeight="Bold"
                           Text="⚠️ 提示：自动模式下请确保鼠标光标在要截取的窗口区域内！" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 截屏区域设置 -->
        <GroupBox Grid.Row="2" Header="截屏区域设置" Margin="0,0,0,15">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="左上 X 坐标:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CaptureLeft}" Width="100" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                    <TextBlock Text="左上 Y 坐标:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CaptureTop}" Width="100" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,20,0">
                    <TextBlock Text="宽度:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CaptureWidth}" Width="100" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="高度:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CaptureHeight}" Width="100" Padding="5"/>
                </StackPanel>

                <Button Grid.Column="4"
                       Content="选择区域"
                       Command="{Binding SelectCaptureRegionCommand}"
                       Margin="20,12,0,0"
                       Padding="15,5"/>
            </Grid>
        </GroupBox>

        <!-- 模式和滚动设置 -->
        <GroupBox Grid.Row="3" Header="捕获模式" Margin="0,0,0,15">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                    <TextBlock Text="捕获模式:" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="自动滚动" 
                                    IsChecked="{Binding ManualScrollMode, Converter={StaticResource InverseBooleanConverter}}"
                                    Margin="0,0,15,0"/>
                        <RadioButton Content="手动滚动" 
                                    IsChecked="{Binding ManualScrollMode}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,30,0"
                           Visibility="{Binding ManualScrollMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="滚动间隔 (毫秒):" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider Value="{Binding ScrollInterval}" 
                                Minimum="100" 
                                Maximum="500" 
                                Width="200"
                                TickFrequency="50"
                                IsSnapToTickEnabled="True"/>
                        <TextBlock Text="{Binding ScrollInterval, StringFormat='{}{0} ms'}" 
                                   VerticalAlignment="Center" 
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <CheckBox Content="自动检测滚动结束" 
                             IsChecked="{Binding AutoStopOnNoChange}"
                             VerticalAlignment="Center"
                             Visibility="{Binding ManualScrollMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 状态信息 -->
        <Border Grid.Row="4" 
                Background="#F5F5F5" 
                CornerRadius="5" 
                Padding="20"
                Margin="0,0,0,15">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" 
                           FontSize="18" 
                           HorizontalAlignment="Center"
                           Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="已捕获帧数: " FontSize="14"/>
                    <TextBlock Text="{Binding FrameCount}" 
                               FontSize="24" 
                               FontWeight="Bold"
                               Foreground="#0078D4"/>
                </StackPanel>

                <ProgressBar IsIndeterminate="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Width="300"
                             Height="20"
                             Margin="0,15,0,0"/>
            </StackPanel>
        </Border>

        <!-- 按钮 -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                     Text="{Binding StatusMessage}"
                     VerticalAlignment="Center"
                     Foreground="Gray"/>

            <Button Grid.Column="2"
                   Content="重置"
                   Command="{Binding ResetCommand}"
                   Margin="5,0"
                   Padding="15,8"/>

            <Button Grid.Column="3"
                   Content="打开截图"
                   Command="{Binding OpenOutputFolderCommand}"
                   Margin="5,0"
                   Padding="15,8"
                   IsEnabled="{Binding OutputPath, Converter={StaticResource StringNotEmptyConverter}}"/>

            <Button Grid.Column="4"
                   Content="捕获下一帧"
                   Command="{Binding CaptureNextFrameCommand}"
                   Margin="5,0"
                   Padding="15,8"
                   Background="#FF9800"
                   Foreground="White"
                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Button Grid.Column="5"
                   Content="{Binding IsBusy, Converter={StaticResource BoolToStartStopConverter}, FallbackValue='开始截屏'}"
                   Command="{Binding StartCaptureCommand}"
                   Visibility="{Binding IsBusy, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}"
                   Background="#4CAF50"
                   Foreground="White"
                   Padding="20,10"
                   FontWeight="Bold"
                   Margin="5,0,0,0"/>

            <Button Grid.Column="5"
                   Content="停止截屏"
                   Command="{Binding StopCaptureCommand}"
                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Background="#F44336"
                   Foreground="White"
                   Padding="20,10"
                   FontWeight="Bold"
                   Margin="5,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
