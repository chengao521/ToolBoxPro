<UserControl x:Class="ToolBoxPro.Views.ProteinViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="蛋白质 3D 结构查看器"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <Border Grid.Row="1"
                    Background="#E8F4FF"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,18">
                <TextBlock TextWrapping="Wrap"
                           LineHeight="22"
                           Text="根据 PDB 文件生成单文件 Three.js 蛋白质 3D 查看器。支持球棍模型与彩带模型，可切换显示、悬停查看原子信息。生成的 HTML 可直接用浏览器打开。"/>
            </Border>

            <GroupBox Grid.Row="2" Header="蛋白质数据" Margin="0,0,0,15">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="页面标题:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Title}" Padding="6" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="PDB 文件:" VerticalAlignment="Center" Margin="0,0,10,8"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PdbFileUrl}" Padding="6" Margin="0,0,10,8"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="选择文件" Command="{Binding SelectPdbFileCommand}" Padding="12,5" Margin="0,0,8,8"/>

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                        <TextBlock Text="预设:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Content="CYP450" Command="{Binding UseCYP450PresetCommand}" Padding="12,5" Margin="0,0,8,0"/>
                        <Button Content="血红蛋白" Command="{Binding UseHemoglobinPresetCommand}" Padding="12,5" Margin="0,0,8,0"/>
                        <Button Content="溶菌酶" Command="{Binding UseLysozymePresetCommand}" Padding="12,5"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="模型显示" Margin="0,0,0,15">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="显示模式" FontWeight="Bold" Margin="0,0,0,8"/>
                        <CheckBox Content="球棍模型" IsChecked="{Binding ShowBallAndStick}" Margin="0,0,0,6"/>
                        <CheckBox Content="彩带模型" IsChecked="{Binding ShowRibbon}" Margin="0,0,0,6"/>
                        <CheckBox Content="残基标签" IsChecked="{Binding ShowLabels}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="参数" FontWeight="Bold" Margin="0,0,0,8"/>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="原子半径缩放" Margin="0,0,0,4"/>
                            <Slider Value="{Binding AtomRadiusScale}" Minimum="1" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding AtomRadiusScale, StringFormat='当前值：{0}'}" Foreground="Gray"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="彩带宽度" Margin="0,0,0,4"/>
                            <Slider Value="{Binding RibbonWidth}" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Text="{Binding RibbonWidth, StringFormat='当前值：{0}'}" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="4" Header="颜色设置" Margin="0,0,0,15">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,10">
                        <TextBlock Text="α-螺旋颜色" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding HelixColor}" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,10">
                        <TextBlock Text="β-折叠颜色" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding SheetColor}" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,10">
                        <TextBlock Text="无规卷曲颜色" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding CoilColor}" Padding="6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,0,10">
                        <TextBlock Text="背景颜色" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding BackgroundColor}" Padding="6"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="5" Header="输出设置" Margin="0,0,0,15">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="输出文件:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding OutputPath}" IsReadOnly="True" Padding="6" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="浏览..." Command="{Binding SelectOutputPathCommand}" Padding="15,6"/>
                </Grid>
            </GroupBox>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Width="160" Height="18" Margin="0,0,12,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <Button Grid.Column="1" Content="恢复默认样式" Command="{Binding ResetStyleCommand}" Padding="12,6" Margin="0,0,8,0"/>
                <Button Grid.Column="2" Content="打开输出位置" Command="{Binding OpenOutputFolderCommand}" Padding="15,8" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="生成 HTML" Command="{Binding GenerateViewerCommand}" Padding="18,8" Margin="0,0,8,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                <Button Grid.Column="4" Content="生成并打开" Command="{Binding GenerateAndOpenCommand}" Padding="20,8"
                        Background="#0078D4" Foreground="White" FontWeight="Bold"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
