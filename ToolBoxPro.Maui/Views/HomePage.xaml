<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ToolBoxPro.ViewModels"
             x:Class="ToolBoxPro.Views.HomePage"
             Title="ToolBox Pro"
             BackgroundColor="{StaticResource BackgroundColor}">

    <CollectionView ItemsSource="{Binding Tools}"
                    Margin="12"
                    SelectionMode="None">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame BorderColor="#DDDDDD"
                       CornerRadius="12"
                       HasShadow="{Binding IsComingSoon, Converter={StaticResource InverseBooleanConverter}}"
                       Padding="16"
                       BackgroundColor="{StaticResource SurfaceColor}"
                       IsVisible="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToToolCommand}"
                                              CommandParameter="{Binding}"/>
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0"
                               Text="{Binding Icon}"
                               FontSize="36"
                               VerticalOptions="Center"
                               Margin="0,0,12,0"/>

                        <VerticalStackLayout Grid.Column="1"
                                             VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource TextColor}"/>
                            <Label Text="{Binding Description}"
                                   FontSize="13"
                                   TextColor="{StaticResource HintColor}"
                                   Margin="0,2,0,0"/>
                            <Label Text="{Binding Category}"
                                   FontSize="11"
                                   TextColor="{StaticResource PrimaryColor}"
                                   Margin="0,2,0,0"/>
                        </VerticalStackLayout>

                        <Label Grid.Column="2"
                               Text="{Binding IsComingSoon, Converter={StaticResource ComingSoonTextConverter}}"
                               FontSize="14"
                               TextColor="{Binding IsComingSoon, Converter={StaticResource ComingSoonColorConverter}}"
                               VerticalOptions="Center"
                               Margin="12,0,0,0"/>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
