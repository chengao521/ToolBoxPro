<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToolBoxPro.Views.FileRenamePage"
             Title="批量重命名"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="14" Padding="16">

            <!-- 源目录 -->
            <Frame BorderColor="#DDDDDD" CornerRadius="10" Padding="14" BackgroundColor="{StaticResource SurfaceColor}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="6">
                        <Label Text="目标文件夹" FontSize="13" TextColor="{StaticResource HintColor}"/>
                        <Entry Text="{Binding SourceDirectory}" IsReadOnly="True" Placeholder="未选择文件夹"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="浏览" Command="{Binding SelectDirectoryCommand}" BackgroundColor="{StaticResource PrimaryColor}" Margin="8,0,0,0"/>
                </Grid>
            </Frame>

            <!-- 搜索模式和选项 -->
            <Frame BorderColor="#DDDDDD" CornerRadius="10" Padding="14" BackgroundColor="{StaticResource SurfaceColor}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="搜索与重命名选项" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextColor}"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0" Text="{Binding SearchPattern}" Placeholder="搜索模式（如 *.jpg）"/>
                        <Button Grid.Column="1" Text="预览" Command="{Binding PreviewFilesCommand}" BackgroundColor="{StaticResource SecondaryColor}" Margin="8,0,0,0"/>
                    </Grid>
                    <Label Text="{Binding FileCount, StringFormat='找到 {0} 个文件'}" FontSize="12" TextColor="{StaticResource PrimaryColor}" IsVisible="{Binding FileCount, Converter={StaticResource NonZeroConverter}}"/>

                    <Picker ItemsSource="{Binding RenameModes}" SelectedItem="{Binding SelectedMode}" Title="重命名模式"/>

                    <Entry Text="{Binding NewNamePattern}" Placeholder="命名模式（如 {name}_{index}{ext}）"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <Entry Grid.Column="0" Text="{Binding StartIndex, StringFormat='{0}'}" Keyboard="Numeric" Placeholder="起始编号"/>
                        <Button Grid.Column="1" Text="生成示例" BackgroundColor="{StaticResource PrimaryColor}" Margin="8,0,0,0"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <Entry Grid.Column="0" Text="{Binding FindText}" Placeholder="查找文本"/>
                        <Entry Grid.Column="1" Text="{Binding ReplaceText}" Placeholder="替换为" Margin="8,0,0,0"/>
                    </Grid>

                    <CheckBox IsChecked="{Binding IncludeSubdirectories}" HorizontalOptions="Start"/>
                    <Label Text="包含子目录" FontSize="12" TextColor="{StaticResource HintColor}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- 状态和操作 -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource PrimaryColor}"/>
            <Label Text="{Binding StatusMessage}" FontSize="13" TextColor="{StaticResource HintColor}" HorizontalOptions="Center"/>

            <Grid ColumnDefinitions="*,*,*" Margin="0,8,0,0">
                <Button Grid.Column="0" Text="清空" Command="{Binding ClearCommand}" BackgroundColor="#757575"/>
                <Button Grid.Column="2" Text="执行重命名" Command="{Binding ExecuteRenameCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" BackgroundColor="{StaticResource PrimaryColor}"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
